generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  umkm
  supplier
  admin
}

enum ProcurementStatus {
  open
  closed
  delivered
}

enum ItemStatus {
  pending
  paid
}

// Perjalanan barang untuk satu kontribusi UMKM, terpisah dari status
// pembayarannya. Inti sistem rekening bersama (escrow): uang yang sudah
// dibayar UMKM tetap ditahan platform sampai UMKM sendiri menyatakan
// barangnya diterima — sama seperti tombol "Barang Sudah Diterima" di
// lokapasar pada umumnya.
enum FulfillmentStatus {
  menunggu // sudah dibayar, pemasok belum mengirim
  dikirim // pemasok menyatakan barang sudah berangkat
  diterima // UMKM mengonfirmasi barang sampai — dana boleh diteruskan
  komplain // UMKM melaporkan masalah; hitungan otomatis dihentikan
}

enum TransactionStatus {
  pending
  success
  failed
}

enum PaymentMethod {
  gateway
  transfer
  cash
}

enum PayoutStatus {
  pending
  paid
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  phone        String?
  createdAt    DateTime @default(now()) @map("created_at")

  avatarUrl  String? @map("avatar_url")
  avatarPath String? @map("avatar_path")

  emailVerified      Boolean   @default(false) @map("email_verified")
  emailVerifiedAt    DateTime? @map("email_verified_at")
  verifyTokenHash    String?   @map("verify_token_hash")
  verifyTokenExpires DateTime? @map("verify_token_expires")
  verifySentAt       DateTime? @map("verify_sent_at")

  // Tambahan untuk Reset Password Mandiri
  resetPasswordToken   String?   @map("reset_password_token")
  resetPasswordExpires DateTime? @map("reset_password_expires")

  // Autentikasi berlapis — kode OTP lewat email sebagai lapis kedua
  // setelah password benar, sebelum token JWT diterbitkan.
  otpHash     String?   @map("otp_hash")
  otpExpires  DateTime? @map("otp_expires")
  otpSentAt   DateTime? @map("otp_sent_at")
  // Dibatalkan otomatis setelah beberapa kali salah, supaya kode 6 digit
  // tidak bisa ditebak lewat percobaan bertubi-tubi (brute force).
  otpAttempts Int       @default(0) @map("otp_attempts")

  umkmProfile     UmkmProfile?
  supplierProfile SupplierProfile?
  trustedDevices  TrustedDevice[]

  @@map("users")
}

// Perangkat yang sudah pernah lolos OTP login. Selama tokennya masih
// berlaku, login berikutnya dari perangkat yang sama tidak perlu OTP
// lagi — mirip "ingat perangkat ini" di WhatsApp Web. Login dari
// perangkat lain (tanpa token ini, atau tokennya kedaluwarsa) tetap
// wajib lewat OTP seperti biasa.
model TrustedDevice {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  tokenHash  String   @unique @map("token_hash")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  expiresAt  DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("trusted_devices")
}

model UmkmProfile {
  id           String @id @default(uuid())
  userId       String @unique @map("user_id")
  businessName String @map("business_name")
  businessType String @map("business_type")
  city         String
  address      String

  // Hasil geocoding alamat (Nominatim/OpenStreetMap), diisi otomatis
  // saat profil dibuat/diubah. Kalau kosong, jarak/pengiriman jatuh
  // kembali ke perkiraan titik-pusat-kota di utils/jarak.js.
  latitude  Float?
  longitude Float?

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  salesRecords     SalesRecord[]
  forecastResults  ForecastResult[]
  procurementItems ProcurementOrderItem[]

  @@map("umkm_profiles")
}

model SupplierProfile {
  id        String @id @default(uuid())
  userId    String @unique @map("user_id")
  groupName String @map("group_name")
  city      String
  address   String

  // Hasil geocoding alamat (Nominatim/OpenStreetMap) — lihat catatan
  // yang sama di UmkmProfile.
  latitude  Float?
  longitude Float?

  // Rekening tujuan penerusan dana dari platform ke pemasok
  bankName          String? @map("bank_name")
  bankAccountNumber String? @map("bank_account_number")
  bankAccountHolder String? @map("bank_account_holder")

  // Dompet digital — di Indonesia satu nomor HP umumnya dipakai untuk
  // beberapa aplikasi sekaligus (DANA/GoPay/ShopeePay/OVO), jadi cukup
  // satu nomor + nama, dengan daftar penyedia mana saja yang aktif.
  ewalletNumber    String?  @map("ewallet_number")
  ewalletHolder    String?  @map("ewallet_holder")
  ewalletProviders String[] @default([]) @map("ewallet_providers")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]

  @@map("supplier_profiles")
}

model Product {
  id         String  @id @default(uuid())
  supplierId String  @map("supplier_id")
  name       String
  category   String
  unit       String
  price      Decimal @db.Decimal(12, 2)
  stock      Int

  // Harga grosir: berlaku otomatis kalau total pesanan kolektif
  // sudah mencapai bulkMinQty. Inti dari Collective Procurement.
  bulkPrice  Decimal? @map("bulk_price") @db.Decimal(12, 2)
  bulkMinQty Int?     @map("bulk_min_qty")

  supplier          SupplierProfile    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  procurementOrders ProcurementOrder[]

  @@map("products")
}

model SalesRecord {
  id          String   @id @default(uuid())
  umkmId      String   @map("umkm_id")
  productName String   @map("product_name")
  quantity    Decimal  @db.Decimal(12, 2)
  date        DateTime @db.Date

  umkm UmkmProfile @relation(fields: [umkmId], references: [id], onDelete: Cascade)

  @@map("sales_records")
}

model ForecastResult {
  id                String   @id @default(uuid())
  umkmId            String   @map("umkm_id")
  productName       String   @map("product_name")
  predictedQuantity Decimal  @map("predicted_quantity") @db.Decimal(12, 2)
  period            DateTime @db.Date
  createdAt         DateTime @default(now()) @map("created_at")

  umkm UmkmProfile @relation(fields: [umkmId], references: [id], onDelete: Cascade)

  @@map("forecast_results")
}

model ProcurementOrder {
  id            String            @id @default(uuid())
  productId     String            @map("product_id")
  totalQuantity Decimal           @default(0) @map("total_quantity") @db.Decimal(12, 2)
  status        ProcurementStatus @default(open)
  deadline      DateTime          @db.Date
  createdAt     DateTime          @default(now()) @map("created_at")

  product Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  items   ProcurementOrderItem[]

  @@map("procurement_orders")
}

model ProcurementOrderItem {
  id       String     @id @default(uuid())
  orderId  String     @map("order_id")
  umkmId   String     @map("umkm_id")
  quantity Decimal    @db.Decimal(12, 2)
  status   ItemStatus @default(pending)

  // ---- Serah terima barang (escrow) ----
  // status di atas soal UANG, blok di bawah soal BARANG. Dana pemasok
  // baru boleh dicairkan setelah keduanya beres.
  fulfillmentStatus FulfillmentStatus @default(menunggu) @map("fulfillment_status")

  // Diisi saat pemasok menekan "Tandai Dikirim"
  shippedAt DateTime? @map("shipped_at")

  // Batas konfirmasi otomatis. Kalau UMKM tidak menekan tombol apa pun
  // sampai waktu ini lewat, pesanan dianggap diterima supaya dana
  // pemasok tidak tertahan selamanya. Dikosongkan begitu ada komplain.
  autoConfirmAt DateTime? @map("auto_confirm_at")

  // Diisi saat barang dinyatakan diterima — oleh UMKM, oleh hitungan
  // otomatis, atau oleh admin dalam kasus sengketa.
  receivedAt   DateTime? @map("received_at")
  receivedNote String?   @map("received_note")

  // Komplain UMKM: menghentikan hitungan otomatis dan menahan dana
  // sampai admin turun tangan.
  complaintAt   DateTime? @map("complaint_at")
  complaintNote String?   @map("complaint_note")

  order        ProcurementOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  umkm         UmkmProfile      @relation(fields: [umkmId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("procurement_order_items")
}

model Transaction {
  id               String            @id @default(uuid())
  orderItemId      String            @map("order_item_id")
  amount           Decimal           @db.Decimal(12, 2)
  paymentProofUrl  String?           @map("payment_proof_url")
  paymentProofPath String?           @map("payment_proof_path")
  status           TransactionStatus @default(pending)
  createdAt        DateTime          @default(now()) @map("created_at")

  // Pendapatan PanganKreatif dari transaksi ini. Disimpan per baris
  // supaya riwayat tetap akurat walau tarif komisi berubah nanti.
  platformFee    Decimal @default(0) @map("platform_fee") @db.Decimal(12, 2)
  commissionRate Decimal @default(0) @map("commission_rate") @db.Decimal(5, 4)

  // Margin distribusi atas volume yang disalurkan — sumber pendapatan
  // kedua pada Tabel 5.6, terpisah dari komisi transaksi.
  distributionMargin Decimal @default(0) @map("distribution_margin") @db.Decimal(12, 2)
  marginRate         Decimal @default(0) @map("margin_rate") @db.Decimal(5, 4)

  supplierPayout Decimal @default(0) @map("supplier_payout") @db.Decimal(12, 2)

  // Cara membayar: gateway (daring), transfer (manual), atau tunai
  paymentMethod PaymentMethod @default(gateway) @map("payment_method")

  // Pembayaran daring lewat payment gateway.
  gatewayOrderId String?   @unique @map("gateway_order_id")
  snapToken      String?   @map("snap_token")
  paymentChannel String?   @map("payment_channel")
  paidAt         DateTime? @map("paid_at")

  // ---- Rekening bersama (escrow) ----
  // Selama kolom ini masih kosong, uangnya memang sudah ada di rekening
  // platform tetapi BELUM boleh diteruskan ke pemasok: barangnya belum
  // dinyatakan diterima UMKM. Admin tidak bisa melewati aturan ini lewat
  // halaman payout — satu-satunya jalan pintas adalah pelepasan paksa
  // yang alasannya wajib diisi dan tercatat di dua kolom berikutnya.
  escrowReleasedAt    DateTime? @map("escrow_released_at")
  // konfirmasi_umkm | otomatis | admin_sengketa
  escrowReleaseReason String?   @map("escrow_release_reason")
  escrowReleaseNote   String?   @map("escrow_release_note")
  escrowReleasedBy    String?   @map("escrow_released_by")

  // Penerusan dana dari platform ke pemasok.
  // Dana masuk lebih dulu ke rekening platform, lalu diteruskan
  // setelah dikurangi komisi. Statusnya dicatat di sini.
  payoutStatus    PayoutStatus @default(pending) @map("payout_status")
  payoutAt        DateTime?    @map("payout_at")
  payoutNote      String?      @map("payout_note")
  payoutProofUrl  String?      @map("payout_proof_url")
  payoutProofPath String?      @map("payout_proof_path")

  orderItem ProcurementOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  // CATATAN: ada satu unique index PARSIAL di database yang tidak
  // muncul di sini — "transactions_pending_per_item" pada (order_item_id)
  // WHERE status = 'pending', dari migration 20260830020000. Prisma
  // belum mendukung index bersyarat di schema DSL, jadi ini hanya
  // ada sebagai migration SQL murni. Jangan kaget kalau `prisma migrate
  // dev` menandainya sebagai "drift" — itu bukan berarti hilang, index
  // itu tetap ada di database.
  //
  // Hal yang sama berlaku untuk dua index bersyarat dari migration
  // 20260909120000: "transactions_escrow_idx" di tabel ini dan
  // "procurement_order_items_auto_confirm_idx" di tabel item. Keduanya
  // juga hanya hidup sebagai SQL murni.
  @@map("transactions")
}
